# Copy to .env (git-ignored) or export these in your shell. Never commit real values.

# Shared secret for signing/verifying dev tokens. At least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_JWT_SECRET=

# Who issues tokens (the authorization server) and who they are for (this server).
MCP_ISSUER_URL=http://localhost:9000
MCP_SERVER_URL=http://localhost:8000/mcp
